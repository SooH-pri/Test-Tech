{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodlift-telegram-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "workout-bot",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
  }]
}
